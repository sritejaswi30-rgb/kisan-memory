# LLM provider: "gemini" (primary) or "groq" (fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Comma-separated fallback order; the next model is used if one is rate-limited.
GEMINI_MODEL=gemini-3.7-flash,gemini-flash-lite-latest

HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=kisan-memory
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=
